APP_NAME="WA Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.your-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wa_platform
DB_USERNAME=wa_platform
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

SANCTUM_STATEFUL_DOMAINS=your-domain.com
FRONTEND_URL=https://your-domain.com

# Meta WhatsApp Business Platform. Never expose the secret or tokens to the browser.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=
META_REDIRECT_URI=
META_APP_SCOPES="whatsapp_business_management,whatsapp_business_messaging,business_management"
