APP_NAME="WA Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wa_platform
DB_USERNAME=wa_platform
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SANCTUM_STATEFUL_DOMAINS=localhost
FRONTEND_URL=http://localhost:8080

# Meta WhatsApp Business Platform. Never expose the secret or tokens to the browser.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=
META_REDIRECT_URI=
META_APP_SCOPES="whatsapp_business_management,whatsapp_business_messaging,business_management"
